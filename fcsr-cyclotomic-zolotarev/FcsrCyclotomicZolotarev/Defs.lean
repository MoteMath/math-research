/-!
# Core Definitions for FCSR Cyclotomic and Zolotarev Laws (`fcsr-cyclotomic-zolotarev`)

Pure-`Init` (zero Mathlib) definitions: FCSR specification and state, the 2-adic potential, step and inverse step, periodic core, complement, section quantum and section sum, repunits, and the family specializations.
-/

namespace SiliconFCSR

def bit (n i : Nat) : Nat := (n / 2 ^ i) % 2

theorem pow2_pred_mul (m : Nat) (hm : 1 ≤ m) : 2 ^ m = 2 * 2 ^ (m - 1) := by
  have h : m = (m - 1) + 1 := by omega
  conv => lhs; rw [h]
  rw [Nat.pow_succ, Nat.mul_comm]

def sumNat (n : Nat) (f : Nat → Nat) : Nat :=
  match n with
  | 0 => 0
  | k + 1 => sumNat k f + f k

def sumInt (n : Nat) (f : Nat → Int) : Int :=
  match n with
  | 0 => 0
  | k + 1 => sumInt k f + f k

theorem sumNat_le_sumNat (n : Nat) (f g : Nat → Nat) (h : ∀ i, i < n → f i ≤ g i) :
    sumNat n f ≤ sumNat n g := by
  induction n with
  | zero => exact Nat.le_refl 0
  | succ k ih =>
    simp only [sumNat]
    have h1 := ih (fun i hi => h i (by omega))
    have h2 := h k (by omega)
    omega

theorem sum_pow2_eq (k : Nat) :
    sumNat k (fun j => 2 ^ j) + 1 = 2 ^ k := by
  induction k with
  | zero => simp [sumNat]
  | succ m ih =>
    simp only [sumNat, Nat.pow_succ]
    omega

-- ============================================================================
-- Section 1: Pure-Silicon Hardware Fibonacci FCSR Formalization
-- ============================================================================

structure FCSRSpec where
  c : Nat
  r : Nat
  hr : 1 ≤ r
  hc_lo : 2 ^ (r - 1) ≤ c
  hc_hi : c < 2 ^ r
  hc_ge2 : 2 ≤ c

namespace FCSRSpec

def q (spec : FCSRSpec) : Nat := 2 * spec.c - 1

def qInt (spec : FCSRSpec) : Int := (spec.q : Int)

theorem pow_r_eq (spec : FCSRSpec) : 2 ^ spec.r = 2 * 2 ^ (spec.r - 1) :=
  pow2_pred_mul spec.r spec.hr

theorem pow_r_pos (spec : FCSRSpec) : 0 < 2 ^ spec.r := Nat.pow_pos (by omega)

def tapWeight (spec : FCSRSpec) : Nat :=
  sumNat spec.r (fun j => bit spec.c j)

end FCSRSpec

structure FCSRState (spec : FCSRSpec) where
  reg : Nat
  hreg : reg < 2 ^ spec.r
  carry : Int

namespace FCSRSpec

def outBit {spec : FCSRSpec} (s : FCSRState spec) : Nat := s.reg % 2

def tapDot (spec : FCSRSpec) (reg : Nat) : Nat :=
  sumNat spec.r (fun j => bit spec.c j * bit reg (spec.r - 1 - j))

def sigma (spec : FCSRSpec) (s : FCSRState spec) : Int :=
  s.carry + (spec.tapDot s.reg : Int)

def step (spec : FCSRSpec) (s : FCSRState spec) : FCSRState spec :=
  let sg := spec.sigma s
  let newTop := (sg % 2).toNat
  let newCarry := sg / 2
  let newReg := s.reg / 2 + newTop * 2 ^ (spec.r - 1)
  have htop_lt : newTop < 2 := by omega
  have hreg_lt : newReg < 2 ^ spec.r := by
    have hdiv : s.reg / 2 < 2 ^ (spec.r - 1) := by
      have hpr := spec.pow_r_eq
      have hsr := s.hreg
      omega
    have hpr := spec.pow_r_eq
    have htop_le : newTop ≤ 1 := by omega
    have hmul : newTop * 2 ^ (spec.r - 1) ≤ 2 ^ (spec.r - 1) := by
      calc newTop * 2 ^ (spec.r - 1) ≤ 1 * 2 ^ (spec.r - 1) := Nat.mul_le_mul_right _ htop_le
      _ = 2 ^ (spec.r - 1) := Nat.one_mul _
    omega
  ⟨newReg, hreg_lt, newCarry⟩

def stepN (spec : FCSRSpec) : Nat → FCSRState spec → FCSRState spec
  | 0, s => s
  | n + 1, s => spec.stepN n (spec.step s)

/-- Exact 2-adic numerator potential `P_q(reg, carry) ∈ ℤ`. -/
def potentialZero (spec : FCSRSpec) (reg : Nat) : Int :=
  sumInt spec.r (fun j =>
    ((bit spec.c j * 2 ^ (j + 1) * (reg % 2 ^ (spec.r - 1 - j)) : Nat) : Int)) - (reg : Int)

def potential (spec : FCSRSpec) (s : FCSRState spec) : Int :=
  spec.potentialZero s.reg - s.carry * ((2 ^ spec.r : Nat) : Int)

/-- Canonical 2-adic shift-divide automaton on ℤ. -/
def divStep (q : Nat) (p : Int) : Int :=
  (p - (q : Int) * (p % 2)) / 2

def divStepN (q : Nat) : Nat → Int → Int
  | 0, p => p
  | n + 1, p => divStepN q n (divStep q p)

/-- `n`-bit output word generated by the FCSR starting at state `s`. -/
def wordRun (spec : FCSRSpec) (s : FCSRState spec) (n : Nat) : Nat :=
  sumNat n (fun t => outBit (spec.stepN t s) * 2 ^ t)

/-- Exact `n`-bit word from the canonical 2-adic shift-divide automaton `divStep`. -/
def divWord (q : Nat) (p : Int) (n : Nat) : Nat :=
  sumNat n (fun t => ((divStepN q t p) % 2).toNat * 2 ^ t)

theorem divWord_lt (q : Nat) (p : Int) (n : Nat) : divWord q p n < 2 ^ n := by
  unfold divWord
  have hle : sumNat n (fun t => ((divStepN q t p) % 2).toNat * 2 ^ t) ≤
      sumNat n (fun t => 2 ^ t) := by
    apply sumNat_le_sumNat; intro t _
    have h3 : ((divStepN q t p) % 2).toNat ≤ 1 := by omega
    calc ((divStepN q t p) % 2).toNat * 2 ^ t ≤ 1 * 2 ^ t := Nat.mul_le_mul_right _ h3
    _ = 2 ^ t := Nat.one_mul _
  have := sum_pow2_eq n
  omega

/-- Exact silicon encoder: lifts ANY integer potential `p ∈ ℤ` to its unique hardware state! -/
def encode (spec : FCSRSpec) (p : Int) : FCSRState spec :=
  let reg := divWord spec.q p spec.r
  let carry := (spec.potentialZero reg - p) / ((2 ^ spec.r : Nat) : Int)
  ⟨reg, divWord_lt spec.q p spec.r, carry⟩

/-- Periodic core predicate: `-q < P_q(s) < 0`. -/
def InCore (spec : FCSRSpec) (s : FCSRState spec) : Prop :=
  -spec.qInt < spec.potential s ∧ spec.potential s < 0

/-- Inverse of `divStep` on the open interval `(-q, 0)`. -/
def invDivStep (q : Nat) (p : Int) : Int :=
  if 2 * p > -(q : Int) then 2 * p else 2 * p + (q : Int)

/-- Explicit silicon backward step on the periodic core. -/
def invStep (spec : FCSRSpec) (s : FCSRState spec) : FCSRState spec :=
  spec.encode (invDivStep spec.q (spec.potential s))

/-- Exact hardware state complementation involution `C_q(reg, m) = (2^r - 1 - reg, w - 1 - m)`. -/
def complement (spec : FCSRSpec) (s : FCSRState spec) : FCSRState spec :=
  ⟨2 ^ spec.r - 1 - s.reg, by have := s.hreg; have := spec.pow_r_pos; omega,
   (spec.tapWeight : Int) - 1 - s.carry⟩

/-- Geometric repunit sum `R(d, k) = ∑_{j=0}^{d-1} 2^(j * k)`. -/
def repunit (d k : Nat) : Nat :=
  sumNat d (fun j => 2 ^ (j * k))

/-- `d`-section potential sum `S(t) = ∑_{j=0}^{d-1} P_q(step^{t + j*k} s)`. -/
def sectionSum (spec : FCSRSpec) (s : FCSRState spec) (d k t : Nat) : Int :=
  sumInt d (fun j => spec.potential (spec.stepN (t + j * k) s))

/-- `d`-section quantum `c(t) = -S(t) / q ∈ {1, ..., d - 1}`. -/
def sectionQuantum (spec : FCSRSpec) (s : FCSRState spec) (d k t : Nat) : Int :=
  -(spec.sectionSum s d k t) / spec.qInt

end FCSRSpec

namespace Families

def specPow2Add3 (k : Nat) (hk : 3 ≤ k) : FCSRSpec where
  c := 2 ^ (k - 1) + 2
  r := k
  hr := by omega
  hc_lo := by omega
  hc_hi := by
    rw [pow2_pred_mul k (by omega)]
    have hge4 : 2 ^ 2 ≤ 2 ^ (k - 1) := Nat.pow_le_pow_right (by omega) (by omega)
    omega
  hc_ge2 := Nat.le_add_left 2 (2 ^ (k - 1))

end Families

end SiliconFCSR
