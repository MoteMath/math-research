/-!
# Definitions (`IntegerMpsMpoTensorVerifier`)

All definitions and helper lemmas needed to state the headline theorems.
-/

namespace SiliconTensorEngine

-- ============================================================================
-- PART 1: Exact Integer Vector, Matrix, and Kronecker Algebra
-- ============================================================================

abbrev Vec (D : Nat) := Fin D → Int
abbrev Mat (R C : Nat) := Fin R → Fin C → Int

def sumFin : (n : Nat) → (Fin n → Int) → Int
  | 0, _ => 0
  | n + 1, f => sumFin n (fun i => f i.castSucc) + f (Fin.last n)

def allFin : (n : Nat) → (Fin n → Bool) → Bool
  | 0, _ => true
  | n + 1, p => allFin n (fun i => p i.castSucc) && p (Fin.last n)

-- Vector and Matrix Operations
def vecZero (D : Nat) : Vec D := fun _ => 0
def vecScale {D : Nat} (c : Int) (v : Vec D) : Vec D := fun i => c * v i
def vecDot {D : Nat} (u v : Vec D) : Int := sumFin D (fun i => u i * v i)

def matId (D : Nat) : Mat D D := fun i j => if i = j then 1 else 0
def matMul {R K C : Nat} (A : Mat R K) (B : Mat K C) : Mat R C :=
  fun i j => sumFin K (fun k => A i k * B k j)
def matVec {R C : Nat} (A : Mat R C) (v : Vec C) : Vec R :=
  fun i => sumFin C (fun j => A i j * v j)
def vecMat {R C : Nat} (u : Vec R) (A : Mat R C) : Vec C :=
  fun j => sumFin R (fun i => u i * A i j)

def matPow {D : Nat} (A : Mat D D) : Nat → Mat D D
  | 0 => matId D
  | n + 1 => matMul A (matPow A n)

-- Decidable Boolean Equality Checkers
def vecEq {D : Nat} (u v : Vec D) : Bool :=
  allFin D (fun i => decide (u i = v i))

def matEq {R C : Nat} (A B : Mat R C) : Bool :=
  allFin R (fun i => allFin C (fun j => decide (A i j = B i j)))

-- Exact finite sums over {0, ..., n-1}
def sumNat : Nat → (Nat → Int) → Int
  | 0, _ => 0
  | n + 1, f => sumNat n f + f n

-- ============================================================================
-- PART 3: Kernel-Verified Certificate Compilers (Engines A, B, C, D)
-- ============================================================================

-- Scalar sequence generated by a finite transfer system (u, T, v)
def transferSeq {K : Nat} (u : Vec K) (T : Mat K K) (v : Vec K) (w : Nat) : Int :=
  vecDot u (matVec (matPow T w) v)

-- --- ENGINE A: Right, Left, and Two-Stage Ho-Kalman Reduction Certificates ---

structure RightReductionCert (K r : Nat) where
  w0 : Nat
  d : Int
  M : Mat r r
  P : Mat K r
  u_r : Vec r
  v_r : Vec r

def checkRightReductionCert {K r : Nat} (u : Vec K) (T : Mat K K) (v : Vec K)
    (cert : RightReductionCert K r) : Bool :=
  decide (cert.d ≠ 0) &&
  matEq (matMul T cert.P) (matMul cert.P cert.M) &&
  vecEq (matVec cert.P cert.v_r) (vecScale cert.d (matVec (matPow T cert.w0) v)) &&
  vecEq (vecMat u cert.P) cert.u_r

structure LeftReductionCert (K r : Nat) where
  w0 : Nat
  d : Int
  M : Mat r r
  Q : Mat r K
  u_r : Vec r
  v_r : Vec r

def checkLeftReductionCert {K r : Nat} (u : Vec K) (T : Mat K K) (v : Vec K)
    (cert : LeftReductionCert K r) : Bool :=
  decide (cert.d ≠ 0) &&
  matEq (matMul cert.Q T) (matMul cert.M cert.Q) &&
  vecEq (vecMat cert.u_r cert.Q) (vecScale cert.d (vecMat u (matPow T cert.w0))) &&
  vecEq (matVec cert.Q v) cert.v_r

structure TwoStageCert (K r1 r2 : Nat) where
  stage1 : RightReductionCert K r1
  stage2 : LeftReductionCert r1 r2

def checkTwoStageCert {K r1 r2 : Nat} (u : Vec K) (T : Mat K K) (v : Vec K)
    (cert : TwoStageCert K r1 r2) : Bool :=
  decide (cert.stage2.w0 = 0) &&
  checkRightReductionCert u T v cert.stage1 &&
  checkLeftReductionCert cert.stage1.u_r cert.stage1.M cert.stage1.v_r cert.stage2

-- Stage-2 Invariant-Subspace Orthogonality: T*P = P*M, P*v_r = d*(T^{w0}*v), u*P = 0
def checkOrthogonalityCert {K r : Nat} (u : Vec K) (T : Mat K K) (v : Vec K)
    (cert : RightReductionCert K r) : Bool :=
  checkRightReductionCert u T v cert && vecEq cert.u_r (vecZero r)

-- --- ENGINE C: Minimal-Order Linear Recurrence & Closed-Form Certificates ---

def matLinearComb {r : Nat} (M : Mat r r) (coeffs : Vec r) : Mat r r :=
  fun i j => sumFin r (fun k => coeffs k * matPow M k.val i j)

def checkRecurrenceCert {K r1 r2 : Nat} (u : Vec K) (T : Mat K K) (v : Vec K)
    (cert : TwoStageCert K r1 r2) (coeffs : Vec r2) : Bool :=
  checkTwoStageCert u T v cert &&
  matEq (matPow cert.stage2.M r2) (matLinearComb cert.stage2.M coeffs)

-- Direct Bit-Level Pure-Silicon Binary Functions
def carriesAux : Nat → Nat → Nat → Nat → Nat
  | _, 0, _, _ => 0
  | c, w + 1, x, y =>
      let c' := (x % 2 + y % 2 + c) / 2
      c' + carriesAux c' w (x / 2) (y / 2)

def carries (w x y : Nat) : Nat := carriesAux 0 w x y

def borrowsAux : Nat → Nat → Nat → Nat → Nat
  | _, 0, _, _ => 0
  | b, w + 1, x, y =>
      let b' := if x % 2 < y % 2 + b then 1 else 0
      b' + borrowsAux b' w (x / 2) (y / 2)

def borrows (w x y : Nat) : Nat := borrowsAux 0 w x y

def popcount : Nat → Nat → Nat
  | 0, _ => 0
  | w + 1, x => x % 2 + popcount w (x / 2)

def bitAndPopcount : Nat → Nat → Nat → Nat
  | 0, _, _ => 0
  | w + 1, x, y => (x % 2) * (y % 2) + bitAndPopcount w (x / 2) (y / 2)

def thueMorse (w x : Nat) : Int := (-1 : Int) ^ (popcount w x)
def walshHadamard (w x y : Nat) : Int := (-1 : Int) ^ (bitAndPopcount w x y)

def rudinShapiroAux : Bool → Nat → Nat → Int
  | _, 0, _ => 1
  | prev, w + 1, x =>
      let b := (x % 2 == 1)
      (if prev && b then (-1 : Int) else 1) * rudinShapiroAux b w (x / 2)

def rudinShapiro (w x : Nat) : Int := rudinShapiroAux false w x

def fib : Nat → Nat
  | 0 => 0
  | 1 => 1
  | n + 2 => fib (n + 1) + fib n

-- ============================================================================
-- PART 5: Seven Novel Infinite Binary Theorems Discharged by the Engine
-- ============================================================================

-- ----------------------------------------------------------------------------
-- THEOREM 1: Master Parametric Rudin-Shapiro q-Carry Law (∀ q : Int, ∀ w : Nat)
--   8×8 transfer matrix collapses via symbolic 8×2 RightReductionCert P(q)
-- ----------------------------------------------------------------------------

def rsCarrySum (q : Int) (w : Nat) : Int :=
  sumNat (2 ^ w) (fun x => sumNat (2 ^ w) (fun y =>
    rudinShapiro w x * (q ^ carries w x y * rudinShapiro w y)))

-- ----------------------------------------------------------------------------
-- THEOREM 3: Carry-Parity vs Walsh-Hadamard Fibonacci Law (2^w * F_{w+2})
--   and Borrow-Parity vs Walsh-Hadamard Parametric Law ((q + 1)^w)
-- ----------------------------------------------------------------------------

def carryHadamardTrace (w : Nat) : Int :=
  sumNat (2 ^ w) (fun x => sumNat (2 ^ w) (fun y =>
    (-1 : Int) ^ carries w x y * walshHadamard w x y))

-- General k-th power of the 2^w × 2^w Binary Carry-Parity Matrix C_w
def carryMatPow (w : Nat) : Nat → Nat → Nat → Int
  | 0, x, y => if x = y then 1 else 0
  | k + 1, x, y => sumNat (2 ^ w) (fun z => (-1 : Int) ^ carries w x z * carryMatPow w k z y)

end SiliconTensorEngine
