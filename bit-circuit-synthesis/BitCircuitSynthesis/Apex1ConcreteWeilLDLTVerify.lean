def bvec_equiv : BVec → BVec → Prop
  | BVec.vnil,       BVec.vnil       => True
  | BVec.vnil,       BVec.vcons _ _  => False
  | BVec.vcons _ _,  BVec.vnil       => False
  | BVec.vcons x xs, BVec.vcons y ys => bsign_equiv x y ∧ bvec_equiv xs ys

def BMatEquiv : BMat → BMat → Prop
  | BMat.mnil,       BMat.mnil       => True
  | BMat.mnil,       BMat.mcons _ _  => False
  | BMat.mcons _ _,  BMat.mnil       => False
  | BMat.mcons r rs, BMat.mcons s ss => bvec_equiv r s ∧ BMatEquiv rs ss

theorem bvec_dot_congr_left {r s : BVec} (c : BVec) (h : bvec_equiv r s) :
    bsign_equiv (bvec_dot r c) (bvec_dot s c) := by
  induction r generalizing s c with
  | vnil => cases s with | vnil => exact bsign_equiv_refl _ | vcons _ _ => cases h
  | vcons x xs ih =>
    cases s with
    | vnil => cases h
    | vcons y ys =>
      cases c with
      | vnil => exact bsign_equiv_refl _
      | vcons z zs =>
        dsimp only [bvec_dot]
        exact bsign_add_congr _ _ _ _ (bsign_mul_congr _ _ _ _ h.1 (bsign_equiv_refl z)) (ih zs h.2)

theorem bquad_row_eval_congr {A B : BMat} (u c : BVec) (h : BMatEquiv A B) :
    bsign_equiv (bquad_row_eval A u c) (bquad_row_eval B u c) := by
  induction A generalizing B u with
  | mnil => cases B with | mnil => exact bsign_equiv_refl _ | mcons _ _ => cases h
  | mcons r rs ih =>
    cases B with
    | mnil => cases h
    | mcons s ss =>
      cases u with
      | vnil => exact bsign_equiv_refl _
      | vcons x xs =>
        dsimp only [bquad_row_eval]
        exact bsign_add_congr _ _ _ _
          (bsign_mul_congr _ _ _ _ (bsign_equiv_refl x) (bvec_dot_congr_left c h.1))
          (ih xs h.2)

theorem bquad_form_eval_congr {A B : BMat} (c : BVec) (h : BMatEquiv A B) :
    bsign_equiv (bquad_form_eval A c) (bquad_form_eval B c) :=
  bquad_row_eval_congr c c h

def bvec_append : BVec → BVec → BVec
  | BVec.vnil,       ys => ys
  | BVec.vcons x xs, ys => BVec.vcons x (bvec_append xs ys)

def bmat_append : BMat → BMat → BMat
  | BMat.mnil,       B => B
  | BMat.mcons r rs, B => BMat.mcons r (bmat_append rs B)

def bdiag_sq_eval : BVec → BVec → BSignPair
  | BVec.vnil,        _               => bsign_zero
  | _,                BVec.vnil       => bsign_zero
  | BVec.vcons dk ds, BVec.vcons ck cs =>
      bsign_add (bsign_mul dk (bsign_mul ck ck)) (bdiag_sq_eval ds cs)

theorem bdiag_sq_nonneg (d c : BVec) (hd : bvec_all_pos d) :
    bsign_le bsign_zero (bdiag_sq_eval d c) := by
  induction d generalizing c with
  | vnil => exact bsign_le_refl bsign_zero
  | vcons dk ds ih =>
    cases c with
    | vnil => exact bsign_le_refl bsign_zero
    | vcons ck cs =>
      rcases hd with ⟨⟨p, hp⟩, hds⟩
      dsimp only [bdiag_sq_eval]
      have hm := bsign_mul_nonneg_mono (BBin.pos p) bsign_zero (bsign_mul ck ck) (bsign_sq_nonneg ck)
      have hz : bsign_mul (bsign_nonneg_of (BBin.pos p)) bsign_zero = bsign_zero := rfl
      rw [hz] at hm
      have hh := bsign_le_congr_both (bsign_equiv_refl _) (bsign_mul_congr _ _ _ _ (bsign_equiv_symm _ _ hp) (bsign_equiv_refl _)) hm
      have hs := bsign_le_add_mono _ _ _ _ hh (ih cs hds)
      rw [bsign_add_zero_right] at hs; exact hs

theorem bdiag_sq_strict_pos (d c : BVec) (hlen : BSameVecLen d c)
    (hd : bvec_all_pos d) (hnz : ¬ bvec_all_zero c) :
    bsign_le bsign_one (bdiag_sq_eval d c) := by
  induction hlen with
  | nil => exact absurd trivial hnz
  | @cons dk ck ds cs hsub ih =>
    rcases hd with ⟨⟨p, hp⟩, hds⟩
    dsimp only [bdiag_sq_eval]
    rcases bvec_zero_decidable cs with hcs0 | hcs_nz
    · have hck_nz : ¬ bsign_equiv ck bsign_zero := fun hc0 => hnz ⟨hc0, hcs0⟩
      rcases bsign_sq_pos_of_ne_zero ck hck_nz with ⟨q, hq⟩
      have hpr : bsign_equiv (bsign_mul dk (bsign_mul ck ck)) (bsign_nonneg_of (BBin.pos (bpos_mul p q))) := by
        have hm := bsign_mul_congr _ _ _ _ hp hq; rw [bsign_nonneg_mul] at hm; exact hm
      have hh := bsign_le_congr_both (bsign_equiv_refl _) (bsign_equiv_symm _ _ hpr) (bsign_pos_ge_one (bpos_mul p q))
      have hs := bsign_le_add_mono _ _ _ _ hh (bdiag_sq_nonneg ds cs hds)
      rw [bsign_add_zero_right] at hs; exact hs
    · have ht := ih hds hcs_nz
      have hm := bsign_mul_nonneg_mono (BBin.pos p) bsign_zero (bsign_mul ck ck) (bsign_sq_nonneg ck)
      have hz : bsign_mul (bsign_nonneg_of (BBin.pos p)) bsign_zero = bsign_zero := rfl
      rw [hz] at hm
      have hh := bsign_le_congr_both (bsign_equiv_refl _) (bsign_mul_congr _ _ _ _ (bsign_equiv_symm _ _ hp) (bsign_equiv_refl _)) hm
      have hs := bsign_le_add_mono _ _ _ _ hh ht
      rw [bsign_add_zero_left] at hs; exact hs

def bmat_prepend_zero_col : BMat → BMat
  | BMat.mnil       => BMat.mnil
  | BMat.mcons r rs => BMat.mcons (BVec.vcons bsign_zero r) (bmat_prepend_zero_col rs)

def bdiag_mat : BVec → BMat
  | BVec.vnil       => BMat.mnil
  | BVec.vcons d ds => BMat.mcons (BVec.vcons d BVec.vnil) (bmat_prepend_zero_col (bdiag_mat ds))

theorem bquad_row_prepend_zero (M : BMat) (xs : BVec) (ck : BSignPair) (cs : BVec) :
    bquad_row_eval (bmat_prepend_zero_col M) xs (BVec.vcons ck cs) = bquad_row_eval M xs cs := by
  induction M generalizing xs with
  | mnil => rfl
  | mcons r rs ih =>
    cases xs with
    | vnil => rfl
    | vcons x xs =>
      dsimp only [bmat_prepend_zero_col, bquad_row_eval, bvec_dot]
      rw [bsign_mul_zero_left, bsign_add_zero_left, ih xs]

theorem bquad_form_diag_eq (d c : BVec) :
    bquad_form_eval (bdiag_mat d) c = bdiag_sq_eval d c := by
  unfold bquad_form_eval
  induction d generalizing c with
  | vnil => rfl
  | vcons dk ds ih =>
    cases c with
    | vnil => rfl
    | vcons ck cs =>
      dsimp only [bdiag_mat, bquad_row_eval, bvec_dot, bdiag_sq_eval]
      rw [bsign_add_zero_right, bquad_row_prepend_zero, ih cs, bsign_mul_comm ck (bsign_mul dk ck),
          bsign_mul_assoc dk ck ck]

-- Universal Concrete Weil Certificate Theorem:
-- Whenever `BMatEquiv (bmat_add (bdiag_mat d_pos) (bgram_sum_mat d_tail rows_tail)) W_lo` holds,
-- `W_lo` is strictly positive definite (`1 <= Q(c)` and `Q(c) != 0`) for ALL `c != 0`!
theorem bconcrete_weil_sos_cert_sound
    (W_lo : BMat) (d_pos d_tail : BVec) (rows_tail : BMat) (c : BVec)
    (heq  : BMatEquiv (bmat_add (bdiag_mat d_pos) (bgram_sum_mat d_tail rows_tail)) W_lo)
    (hd   : bvec_all_pos d_pos)
    (ht   : bvec_all_nonneg d_tail)
    (hlen : BSameVecLen d_pos c)
    (hnz  : ¬ bvec_all_zero c) :
    bsign_le bsign_one (bquad_form_eval W_lo c) ∧
    ¬ bsign_equiv (bquad_form_eval W_lo c) bsign_zero := by
  have hcongr := bquad_form_eval_congr c heq
  unfold bquad_form_eval at hcongr
  rw [bquad_row_eval_add] at hcongr
  change bsign_equiv (bsign_add (bquad_form_eval (bdiag_mat d_pos) c)
                                (bquad_form_eval (bgram_sum_mat d_tail rows_tail) c))
                     (bquad_form_eval W_lo c) at hcongr
  rw [bquad_form_diag_eq] at hcongr
  have h1 := bdiag_sq_strict_pos d_pos c hlen hd hnz
  have h2 := bbochner_weil_gram_nonneg d_tail rows_tail c ht
  have hsum := bsign_le_add_mono _ _ _ _ h1 h2
  rw [bsign_add_zero_right] at hsum
  have hge1 := bsign_le_congr_both (bsign_equiv_refl _) hcongr hsum
  exact ⟨hge1, fun hz => bsign_pos_not_le_zero BPos.one (bsign_le_congr_both (bsign_equiv_refl _) hz hge1)⟩

