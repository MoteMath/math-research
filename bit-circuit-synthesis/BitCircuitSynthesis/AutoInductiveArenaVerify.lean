theorem psync_unary_comp_x_ind
    (o_o st_o o_i st_i : BBit → BBit → BBit → BBit) (in_o in_i : BBit) (R : BBit → BBit → BBit)
    (h_init : R in_i in_o = BBit.b1)
    (h_msb  : ∀ si so : BBit, R si so = BBit.b1 → o_i si BBit.b1 BBit.b0 = BBit.b1)
    (h_step : ∀ si so x : BBit, R si so = BBit.b1 → R (st_i si x BBit.b0) (st_o so (o_i si x BBit.b0) BBit.b0) = BBit.b1)
    (h_out  : ∀ si so x : BBit, R si so = BBit.b1 → o_o so (o_i si x BBit.b0) BBit.b0 = x) :
    ∀ x : BBin, run_scan0 o_o st_o in_o BBit.b0 (run_scan0 o_i st_i in_i BBit.b0 x BBin.zero) BBin.zero = x := by
  have h_pos_ne : ∀ (p : BPos) (si so : BBit), R si so = BBit.b1 →
      ∃ q : BPos, bword_to_bin (bword_mode0_tail1 o_i st_i BBit.b0 si (bpos_to_word p)) = BBin.pos q ∧
                  bword_to_bin (bword_mode0_tail1 o_o st_o BBit.b0 so (bpos_to_word q)) = BBin.pos p := by
    intro p; induction p with
    | one =>
      intro si so hR
      refine ⟨BPos.one, ?_, ?_⟩
      · dsimp only [bpos_to_word, bword_mode0_tail1, bword_to_bin]; rw [h_msb si so hR]; rfl
      · dsimp only [bpos_to_word, bword_mode0_tail1, bword_to_bin]
        have ho := h_out si so BBit.b1 hR; rw [h_msb si so hR] at ho; rw [ho]; rfl
    | x0 p ih =>
      intro si so hR
      rcases ih (st_i si BBit.b0 BBit.b0) (st_o so (o_i si BBit.b0 BBit.b0) BBit.b0) (h_step si so BBit.b0 hR) with ⟨q, hq1, hq2⟩
      cases h_oi : o_i si BBit.b0 BBit.b0 with
      | b0 =>
        refine ⟨BPos.x0 q, ?_, ?_⟩
        · dsimp only [bpos_to_word, bword_mode0_tail1, bword_to_bin]; rw [h_oi, hq1]; rfl
        · dsimp only [bpos_to_word, bword_mode0_tail1, bword_to_bin]
          have ho := h_out si so BBit.b0 hR; rw [h_oi] at ho hq2; rw [ho, hq2]; rfl
      | b1 =>
        refine ⟨BPos.x1 q, ?_, ?_⟩
        · dsimp only [bpos_to_word, bword_mode0_tail1, bword_to_bin]; rw [h_oi, hq1]; rfl
        · dsimp only [bpos_to_word, bword_mode0_tail1, bword_to_bin]
          have ho := h_out si so BBit.b0 hR; rw [h_oi] at ho hq2; rw [ho, hq2]; rfl
    | x1 p ih =>
      intro si so hR
      rcases ih (st_i si BBit.b1 BBit.b0) (st_o so (o_i si BBit.b1 BBit.b0) BBit.b0) (h_step si so BBit.b1 hR) with ⟨q, hq1, hq2⟩
      refine ⟨BPos.x1 q, ?_, ?_⟩
      · dsimp only [bpos_to_word, bword_mode0_tail1, bword_to_bin]; rw [h_msb si so hR, hq1]; rfl
      · dsimp only [bpos_to_word, bword_mode0_tail1, bword_to_bin]
        have ho := h_out si so BBit.b1 hR; have hm := h_msb si so hR; rw [hm] at ho hq2; rw [ho, hq2]; rfl
  intro x; cases x with
  | zero => rfl
  | pos p =>
    rcases h_pos_ne p in_i in_o h_init with ⟨q, hq1, hq2⟩
    unfold run_scan0; dsimp only [bbin_to_word]; rw [bword_mode0_pos_nil, hq1]
    dsimp only [bbin_to_word]; rw [bword_mode0_pos_nil, hq2]

