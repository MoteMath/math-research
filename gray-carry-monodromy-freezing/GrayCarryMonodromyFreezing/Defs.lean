/-!
# Definitions (`GrayCarryMonodromyFreezing`)

All definitions and helper lemmas needed to state the headline theorems.
-/

namespace DualGrayCarry
/-- Borrow bit of `x - c - b`: true iff `x.toNat < c.toNat + b.toNat`. -/
def borrowBit (x c b : Bool) : Bool :=
  (!x && (c || b)) || (c && b)

/-- Construct the unique natural number `< 2^w` whose bits `i < w` equal `f i`. -/
def evalBits (f : Nat → Bool) : Nat → Nat
  | 0 => 0
  | w + 1 => evalBits f w + if f w then 2 ^ w else 0

/-- Generic `n`-fold iteration of a function `f : α → α`. -/
def iterFn {α : Type} (f : α → α) : Nat → α → α
  | 0, x => x
  | n + 1, x => f (iterFn f n x)

/-- Exact count of `x < n` satisfying decidable predicate `P`. -/
def countBelow (P : Nat → Bool) : Nat → Nat
  | 0 => 0
  | n + 1 => countBelow P n + if P n then 1 else 0

/-! ## Section 1: Mechanism I — Bidirectional Delay-Feedback Transducer Reduction (BDFTR) -/

/-- A finite-state LSB-to-MSB Mealy bit-transducer reading `(x_i, aux_i)`. -/
structure BitTransducer (Q Aux : Type) where
  init : Q
  nextState : Q → Bool → Aux → Q
  outBit : Q → Bool → Aux → Bool

/-- Transducer state at bit index `i` when processing `x` with auxiliary stream `aux`. -/
def runState {Q Aux : Type} (M : BitTransducer Q Aux) (aux : Nat → Aux) (x : Nat) : Nat → Q
  | 0 => M.init
  | i + 1 => M.nextState (runState M aux x i) (x.testBit i) (aux i)

/-- Output bit `i` of transducer `M` on `(x, aux)`. -/
def transducerOut {Q Aux : Type} (M : BitTransducer Q Aux) (aux : Nat → Aux) (x i : Nat) : Bool :=
  M.outBit (runState M aux x i) (x.testBit i) (aux i)

/-- Width-`w` value produced by transducer `M` on `(x, aux)`. -/
def transducerEval {Q Aux : Type} (M : BitTransducer Q Aux) (aux : Nat → Aux) (x w : Nat) : Nat :=
  evalBits (transducerOut M aux x) w

/-- State of the `k`-bit Delay-Feedback Shift Register (DFSR) compiled from `M`. -/
structure DFSRState (Q : Type) (k : Nat) where
  q : Q
  buf : Fin k → Bool

/-- One clock step of the compiled DFSR with auxiliary input `a`. -/
def dfsrStep {Q Aux : Type} (M : BitTransducer Q Aux) (k : Nat) (hk : 0 < k)
    (a : Aux) (s : DFSRState Q k) : DFSRState Q k :=
  let x0 := s.buf ⟨0, hk⟩
  let q' := M.nextState s.q x0 a
  let xk := M.outBit s.q x0 a
  ⟨q', fun j => if h : j.val + 1 < k then s.buf ⟨j.val + 1, h⟩ else xk⟩

/-- Initial DFSR state loaded with `k`-bit seed `r`. -/
def dfsrInit {Q Aux : Type} (M : BitTransducer Q Aux) (k : Nat) (r : Nat) : DFSRState Q k :=
  ⟨M.init, fun j => r.testBit j.val⟩

/-- DFSR state after `i` steps from seed `r`. -/
def dfsrRun {Q Aux : Type} (M : BitTransducer Q Aux) (k : Nat) (hk : 0 < k)
    (aux : Nat → Aux) (r : Nat) : Nat → DFSRState Q k
  | 0 => dfsrInit M k r
  | i + 1 => dfsrStep M k hk (aux i) (dfsrRun M k hk aux r i)

/-- Bit `i` of the deterministic 2-adic bit-stream generated by the DFSR from seed `r`. -/
def dfsrBit {Q Aux : Type} (M : BitTransducer Q Aux) (k : Nat) (hk : 0 < k)
    (aux : Nat → Aux) (r i : Nat) : Bool :=
  (dfsrRun M k hk aux r i).buf ⟨0, hk⟩

/-- MSB zero-flush acceptance predicate at width `w`: all `k` bits in the buffer at step `w` are `false`. -/
def dfsrFlush {Q Aux : Type} (M : BitTransducer Q Aux) (k : Nat) (hk : 0 < k)
    (aux : Nat → Aux) (w r : Nat) : Bool :=
  decide (∀ j : Fin k, (dfsrRun M k hk aux r w).buf j = false)

/-! ### Instantiation I.1: Borrow Transducer for `((x ^^^ (x >>> k)) + c) % 2^w = x ^^^ m` -/

/-- 2-state borrow transducer for `((x ^^^ (x >>> k)) + c) ≡ x ^^^ m (mod 2^w)`. -/
def borrowTransducer : BitTransducer Bool (Bool × Bool) where
  init := false
  nextState b xi a := borrowBit (xor xi a.2) a.1 b
  outBit b _ a := xor a.1 (xor a.2 b)

/-! ## Section 2: Mechanism II — Carry-Parity Monodromy Freezing Engine (CPMF) -/

/-- Left-shift `k`-Gray linear map `x ↦ x ^^^ (x <<< k)`. -/
def lgray (k x : Nat) : Nat :=
  x ^^^ (x <<< k)

/-- Left-shift Gray + modular increment map on `{0, ..., 2^w - 1}`. -/
def lstep (k c w x : Nat) : Nat :=
  ((lgray k x % 2 ^ w) + c) % 2 ^ w

/-- Minimal period `p > 0` of `x` under `f`. -/
def HasMinPeriod (f : Nat → Nat) (x p : Nat) : Prop :=
  0 < p ∧ iterFn f p x = x ∧ ∀ j, 0 < j → j < p → iterFn f j x ≠ x

/-- Boolean XOR sum `g(0) ^^ g(1) ^^ ... ^^ g(n - 1)`. -/
def xorSum (g : Nat → Bool) : Nat → Bool
  | 0 => false
  | n + 1 => xor (xorSum g n) (g n)

/-- Bit `w` carry out of `(lgray k x % 2^w) + (c % 2^w)`. -/
def carryBit (k c w x : Nat) : Bool :=
  decide (2 ^ w ≤ (lgray k x % 2 ^ w) + (c % 2 ^ w))

/-- Bit `w` shift contribution from `x <<< k`. -/
def shiftBit (k w x : Nat) : Bool :=
  if k ≤ w then x.testBit (w - k) else false

/-- Carry + shift bit contribution (independent of `c.testBit w`). -/
def deltaBit (k c w x : Nat) : Bool :=
  xor (shiftBit k w x) (carryBit k c w x)

/-- Orbit monodromy (delta XOR-sum) at width `w`. -/
def orbitDelta (k c w x p : Nat) : Bool :=
  xorSum (fun j => deltaBit k c w (iterFn (lstep k c w) j x)) p

/-- Orbit carry-parity (carry XOR-sum) at width `w`. -/
def orbitKappa (k c w x p : Nat) : Bool :=
  xorSum (fun j => carryBit k c w (iterFn (lstep k c w) j x)) p

/-- Decidable finite-width certificate check for CPMF full cycle-spectrum freezing at `(k, c0, w0)`. -/
def checkBaseOrbit (k c0 w0 x p : Nat) : Bool :=
  decide (x < 2 ^ w0) &&
  decide (0 < p) &&
  decide (p % 2 = 0) &&
  decide (iterFn (lstep k c0 w0) p x = x) &&
  ((List.range p).all fun j => decide (j = 0) || decide (iterFn (lstep k c0 w0) j x ≠ x)) &&
  orbitDelta k c0 w0 x p &&
  orbitKappa k c0 w0 x p

def checkBaseCert (k c0 w0 : Nat) (certs : List (Nat × Nat)) : Bool :=
  (certs.all fun r => checkBaseOrbit k c0 w0 r.1 r.2) &&
  -- Every y < 2^w0 lies in some orbit of certs
  ((List.range (2 ^ w0)).all fun y =>
    certs.any fun r => (List.range r.2).any fun j => decide (iterFn (lstep k c0 w0) j r.1 = y)) &&
  -- Distinct entries in certs have disjoint orbits at width w0
  (certs.all fun r₁ => certs.all fun r₂ =>
    decide (r₁ = r₂) ||
    ((List.range r₁.2).all fun a => (List.range r₂.2).all fun b =>
      decide (iterFn (lstep k c0 w0) a r₁.1 ≠ iterFn (lstep k c0 w0) b r₂.1)))

/-! ### Instantiation II.1: Exact 5-Cycle Freezing for `L_{1,c}` (`∀ c ≡ 9 mod 32, ∀ w ≥ 5`) -/

def cert_mod32_9 : List (Nat × Nat) := [(0, 16), (2, 4), (3, 4), (6, 4), (7, 4)]

/-! ### Instantiation II.2: Exact 7-Cycle Freezing for `L_{1,c}` (`∀ c ≡ 19 mod 64, ∀ w ≥ 6`) -/

def cert_mod64_19 : List (Nat × Nat) := [(0, 16), (1, 16), (2, 16), (4, 4), (7, 4), (12, 4), (15, 4)]

end DualGrayCarry
