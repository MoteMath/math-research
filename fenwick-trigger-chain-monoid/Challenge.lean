import FenwickTriggerChainMonoid.Defs

/-!
# Trusted Challenge Statements (`fenwick-trigger-chain-monoid`)

Statements of the Fenwick trigger-chain compiler correctness and Myhill-Nerode minimality, the free-vs-nilpotent 2^w monoid dichotomy, universal ancestor-spine collapse, two's-complement word-conjugation duality, and exact Fenwick depth duality.
-/

namespace FenwickTriggerChainMonoidChallenge

open FenwickTransducer in
/-- Theorem 1 (Trigger-chain compiler soundness): evaluating any Fenwick word w modulo 2^n agrees identically with the compiled LSB Mealy transducer. -/
theorem evalWord_mod_eq_compile (w : List FenwickOp) (n x : Nat) :
    evalWord w x % 2 ^ n = (compileTC w).evalMod n x := by
  sorry

open FenwickTransducer in
/-- Theorem 2 (Myhill-Nerode minimality): no LSB Mealy transducer with fewer than (compileSpec w).1.length + 1 states can compute evalWord w mod 2^n for all n and x. -/
theorem compileTC_minimal (w : List FenwickOp) {m : Nat} (T' : LsbTransducer (Fin m))
    (hEq : ∀ n x : Nat, T'.evalMod n x = evalWord w x % 2 ^ n) :
    (compileSpec w).1.length + 1 ≤ m := by
  sorry

open FenwickTransducer in
/-- Theorem 3 (Free monoid on Nat): two Fenwick words induce the same function on all of Nat iff they are syntactically equal. -/
theorem fenwick_free_monoid (w1 w2 : List FenwickOp)
    (h : ∀ x : Nat, evalWord w1 x = evalWord w2 x) : w1 = w2 := by
  sorry

open FenwickTransducer in
/-- Theorem 4 (Finite-width monoid cardinality 2^w): on BitVec w, the monoid generated by U and D has exact cardinality 2^w. -/
theorem fenwick_finite_monoid_card (w : Nat) :
    (finiteMonoidReps w).length = 2 ^ w ∧
    (∀ v : List FenwickOp, ∃ r ∈ finiteMonoidReps w,
        ∀ x < 2 ^ w, evalWord v x % 2 ^ w = evalWord r x % 2 ^ w) ∧
    (∀ i j : Fin (finiteMonoidReps w).length,
        (∀ x < 2 ^ w, evalWord ((finiteMonoidReps w)[i]) x % 2 ^ w =
                      evalWord ((finiteMonoidReps w)[j]) x % 2 ^ w) → i = j) := by
  sorry

open FenwickTransducer in
/-- Theorem 5 (Universal D-spine collapse): any word starting with D collapses to an iterate of D and satisfies (evalWord (.D :: v) x) &&& x = evalWord (.D :: v) x. -/
theorem evalWord_D_spine (v : List FenwickOp) (x : Nat) :
    (∃ m : Nat, evalWord (.D :: v) x = iterN fenwickD m x) ∧
    (evalWord (.D :: v) x &&& x = evalWord (.D :: v) x) := by
  sorry

open FenwickTransducer in
/-- Theorem 6 (Universal U-spine collapse): any word starting with U either vanishes or collapses to an iterate of U bracketing x. -/
theorem evalWord_U_spine (v : List FenwickOp) (x : Nat) :
    evalWord (.U :: v) x = 0 ∨
    ((∃ m : Nat, 1 ≤ m ∧ evalWord (.U :: v) x = iterN fenwickU m x) ∧
     fenwickD (evalWord (.U :: v) x) < x ∧
     x ≤ evalWord (.U :: v) x ∧
     (evalWord (.U :: v) x &&& x = fenwickD (evalWord (.U :: v) x))) := by
  sorry

open FenwickTransducer in
/-- Theorem 7 (Two's-complement word-conjugation duality): conjugating evalWord w by two's-complement negation modulo 2^n equals evalWord (dualWord w). -/
theorem evalWord_twos_complement_duality (w : List FenwickOp) (n x : Nat) :
    (2 ^ n - evalWord w x % 2 ^ n) % 2 ^ n =
    evalWord (dualWord w) ((2 ^ n - x % 2 ^ n) % 2 ^ n) % 2 ^ n := by
  sorry

open FenwickTransducer in
/-- Theorem 8 (Exact Fenwick depth duality): for 0 < x < 2^n, depthU x (2^n) = popcount (2^n - x) and depthU x (2^n) + popcount x = n + 1 - ctz x. -/
theorem fenwick_depth_duality (n x : Nat) (hx0 : 0 < x) (hx : x < 2 ^ n) :
    depthU x (2 ^ n) = popcount (2 ^ n - x) ∧
    depthU x (2 ^ n) + popcount x = n + 1 - ctz x := by
  sorry

end FenwickTriggerChainMonoidChallenge
