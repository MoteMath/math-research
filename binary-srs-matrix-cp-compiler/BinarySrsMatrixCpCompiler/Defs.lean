/-!
# Core Definitions for the Binary SRS Matrix/Critical-Pair Compiler (`binary-srs-matrix-cp-compiler`)

Pure-`Init` (zero Mathlib) definitions of binary string rewriting systems (`SRS`), the one-step /
many-step / convertibility relations, termination / local confluence / confluence / unique normal
forms, materialized `d x d` natural-number matrix layers (`MatrixLayer`, `checkTermination`),
complete critical-pair enumeration with deterministic trace replay (`criticalPairs`,
`checkJoinability`), the pure-data certificate `ConfluenceCert` with its checker `checkCert`, the
computable normalizer `normalize`, and the concrete families `ampSys`, `mod3SRS`, `mersenneSRS`
and `fermatModSRS`.
-/

namespace CertComp16

abbrev Word := List Bool

abbrev Rule := Word × Word

abbrev SRS := List Rule

/-- One-step rewrite `u →_R v` under arbitrary prefix `p` and suffix `s`. -/
inductive Step (R : SRS) : Word → Word → Prop where
  | mk (p s l r : Word) : (l, r) ∈ R → Step R (p ++ l ++ s) (p ++ r ++ s)

/-- Reflexive-transitive closure `u →*_R v`. -/
inductive Steps (R : SRS) : Word → Word → Prop where
  | refl (w : Word) : Steps R w w
  | tail {u v w : Word} : Step R u v → Steps R v w → Steps R u w

/-- Reflexive-symmetric-transitive closure `u ↔*_R v` (congruence generated by `R`). -/
inductive Convertible (R : SRS) : Word → Word → Prop where
  | refl (w : Word) : Convertible R w w
  | fwd {u v w : Word} : Step R u v → Convertible R v w → Convertible R u w
  | bwd {u v w : Word} : Step R v u → Convertible R v w → Convertible R u w

def Joinable (R : SRS) (x y : Word) : Prop :=
  ∃ z, Steps R x z ∧ Steps R y z

def IsNormalForm (R : SRS) (w : Word) : Prop :=
  ∀ v, ¬ Step R w v

/-- Termination: no infinite rewrite sequence `w₀ → w₁ → w₂ → ...`. -/
def Terminating (R : SRS) : Prop :=
  WellFounded (fun v u => Step R u v)

def LocallyConfluent (R : SRS) : Prop :=
  ∀ u v₁ v₂, Step R u v₁ → Step R u v₂ → Joinable R v₁ v₂

def Confluent (R : SRS) : Prop :=
  ∀ u v₁ v₂, Steps R u v₁ → Steps R u v₂ → Joinable R v₁ v₂

def UniqueNormalForms (R : SRS) : Prop :=
  ∀ w, (∃ nf, Steps R w nf ∧ IsNormalForm R nf) ∧
       (∀ n₁ n₂, Steps R w n₁ → IsNormalForm R n₁ → Steps R w n₂ → IsNormalForm R n₂ → n₁ = n₂)

def sumRange : Nat → (Nat → Nat) → Nat
  | 0, _ => 0
  | n + 1, f => sumRange n f + f n

abbrev Mat := List (List Nat)

def matGet (M : Mat) (i j : Nat) : Nat :=
  (M.getD i []).getD j 0

def MatWF (d : Nat) (M : Mat) : Prop :=
  M.length = d ∧ ∀ row ∈ M, row.length = d

def matId (d : Nat) : Mat :=
  (List.range d).map fun i => (List.range d).map fun j => if i == j then 1 else 0

def matMul (d : Nat) (A B : Mat) : Mat :=
  (List.range d).map fun i =>
    (List.range d).map fun j =>
      sumRange d fun k => matGet A i k * matGet B k j

def matEval (d : Nat) (m0 m1 : Mat) : Word → Mat
  | [] => matId d
  | b :: w => matMul d (if b then m1 else m0) (matEval d m0 m1 w)

def matGe (d : Nat) (A B : Mat) : Bool :=
  (List.range d).all fun i =>
    (List.range d).all fun j =>
      decide (matGet B i j ≤ matGet A i j)

def matGtTR (d : Nat) (A B : Mat) : Bool :=
  matGe d A B && decide (matGet B 0 (d - 1) < matGet A 0 (d - 1))

structure MatrixLayer where
  dim : Nat
  m0 : Mat
  m1 : Mat
  deriving Repr, DecidableEq

def checkMatWF (d : Nat) (M : Mat) : Bool :=
  (M.length == d) && M.all (fun row => row.length == d)

def checkLayerValid (L : MatrixLayer) : Bool :=
  decide (1 ≤ L.dim) &&
  checkMatWF L.dim L.m0 &&
  checkMatWF L.dim L.m1 &&
  decide (1 ≤ matGet L.m0 0 0) &&
  decide (1 ≤ matGet L.m0 (L.dim - 1) (L.dim - 1)) &&
  decide (1 ≤ matGet L.m1 0 0) &&
  decide (1 ≤ matGet L.m1 (L.dim - 1) (L.dim - 1))

def checkRuleAgainstLayers : List MatrixLayer → Rule → Bool
  | [], _ => false
  | L :: Ls, (lhs, rhs) =>
    let ml := matEval L.dim L.m0 L.m1 lhs
    let mr := matEval L.dim L.m0 L.m1 rhs
    if matGtTR L.dim ml mr then
      true
    else if matGe L.dim ml mr then
      checkRuleAgainstLayers Ls (lhs, rhs)
    else
      false

def checkTermination (R : SRS) (layers : List MatrixLayer) : Bool :=
  (!layers.isEmpty) &&
  layers.all checkLayerValid &&
  R.all (fun r => (!r.1.isEmpty) && checkRuleAgainstLayers layers r)

def overlapsForOffset (l₁ r₁ l₂ r₂ : Word) (k : Nat) : List (Word × Word) :=
  let a := l₁.take k
  let c := l₁.drop k
  if k + l₂.length ≤ l₁.length then
    if c.take l₂.length == l₂ then
      let b := c.drop l₂.length
      [(r₁, a ++ r₂ ++ b)]
    else []
  else
    if l₂.take c.length == c then
      let d := l₂.drop c.length
      [(r₁ ++ d, a ++ r₂)]
    else []

def criticalPairsPair (rule₁ rule₂ : Rule) : List (Word × Word) :=
  (List.range rule₁.1.length).flatMap (overlapsForOffset rule₁.1 rule₁.2 rule₂.1 rule₂.2)

def criticalPairs (R : SRS) : List (Word × Word) :=
  R.flatMap fun rule₁ => R.flatMap fun rule₂ => criticalPairsPair rule₁ rule₂

abbrev StepCert := Nat × Nat

abbrev JoinWitness := List StepCert × List StepCert

def applyStepCert (R : SRS) (w : Word) (sc : StepCert) : Option Word :=
  let (ri, pos) := sc
  match R[ri]? with
  | none => none
  | some (l, r) =>
    if pos + l.length ≤ w.length then
      let p := w.take pos
      let rest := w.drop pos
      if rest.take l.length == l then
        some (p ++ r ++ rest.drop l.length)
      else none
    else none

def replayTrace (R : SRS) : Word → List StepCert → Option Word
  | w, [] => some w
  | w, sc :: scs =>
    match applyStepCert R w sc with
    | none => none
    | some w' => replayTrace R w' scs

def checkWitness (R : SRS) (cp : Word × Word) (wit : JoinWitness) : Bool :=
  match replayTrace R cp.1 wit.1, replayTrace R cp.2 wit.2 with
  | some z₁, some z₂ => z₁ == z₂
  | _, _ => false

def checkJoinability (R : SRS) (wits : List JoinWitness) : Bool :=
  let cps := criticalPairs R
  (wits.length == cps.length) && (List.zip cps wits).all (fun p => checkWitness R p.1 p.2)

structure ConfluenceCert where
  layers : List MatrixLayer
  witnesses : List JoinWitness
  deriving Repr, DecidableEq

def checkCert (R : SRS) (cert : ConfluenceCert) : Bool :=
  checkTermination R cert.layers && checkJoinability R cert.witnesses

/-- Computable single-step redex finder (leftmost match across rules). -/
def findMatchAt (w l r : Word) (pos : Nat) : Option Word :=
  if pos + l.length ≤ w.length then
    let rest := w.drop pos
    if rest.take l.length == l then
      some (w.take pos ++ r ++ rest.drop l.length)
    else none
  else none

def findRuleStepFrom (w l r : Word) : Nat → Option Word
  | 0 => findMatchAt w l r 0
  | k + 1 =>
    match findRuleStepFrom w l r k with
    | some v => some v
    | none => findMatchAt w l r (k + 1)

def findRuleStep (w : Word) (rule : Rule) : Option Word :=
  findRuleStepFrom w rule.1 rule.2 w.length

def findStep (R : SRS) (w : Word) : Option Word :=
  R.findSome? (findRuleStep w)

theorem findMatchAt_sound {R : SRS} {w l r v : Word} {pos : Nat}
    (hmem : (l, r) ∈ R) (h : findMatchAt w l r pos = some v) : Step R w v := by
  unfold findMatchAt at h
  split at h
  · dsimp only at h
    split at h
    · rename_i _ hmatch
      simp only [beq_iff_eq] at hmatch
      simp only [Option.some.injEq] at h
      have hw : w.take pos ++ l ++ (w.drop pos).drop l.length = w := by
        have h1 : w.take pos ++ w.drop pos = w := List.take_append_drop pos w
        have h2 : (w.drop pos).take l.length ++ (w.drop pos).drop l.length = w.drop pos :=
          List.take_append_drop l.length (w.drop pos)
        rw [hmatch] at h2
        rw [List.append_assoc, h2, h1]
      have hstep := Step.mk (w.take pos) ((w.drop pos).drop l.length) l r hmem
      rw [hw, h] at hstep
      exact hstep
    · cases h
  · cases h

theorem findRuleStepFrom_sound {R : SRS} {w l r v : Word} {k : Nat}
    (hmem : (l, r) ∈ R) (h : findRuleStepFrom w l r k = some v) : Step R w v := by
  induction k with
  | zero => exact findMatchAt_sound hmem h
  | succ k' ih =>
    simp only [findRuleStepFrom] at h
    cases hrec : findRuleStepFrom w l r k' with
    | some u =>
      simp only [hrec, Option.some.injEq] at h
      subst h
      exact ih hrec
    | none =>
      simp only [hrec] at h
      exact findMatchAt_sound hmem h

theorem findStep_sound {R : SRS} {w v : Word} (h : findStep R w = some v) : Step R w v := by
  unfold findStep at h
  induction R with
  | nil => simp at h
  | cons rule Rs ih =>
    simp only [List.findSome?_cons] at h
    cases hr : findRuleStep w rule with
    | some u =>
      simp only [hr, Option.some.injEq] at h
      subst h
      exact findRuleStepFrom_sound (by simp) hr
    | none =>
      simp only [hr] at h
      have hstep := ih h
      cases hstep with
      | mk p s l r hmem => exact Step.mk p s l r (by simp [hmem])

/-- Verified Computable Normalizer driven constructively by `Terminating R`. -/
def normalize (R : SRS) (hTerm : Terminating R) : Word → Word :=
  hTerm.fix fun x ih =>
    match h : findStep R x with
    | none => x
    | some v => ih v (findStep_sound h)

def zeros (n : Nat) : Word := List.replicate n false

def ones (n : Nat) : Word := List.replicate n true

/-- The 5-parameter length-increasing binary amplification-compression system
`S(b, r, s, k, d) = { 10 → 0^b 1, 0^(k+d) → 0^k, 1^r → 1^s }`. -/
def ampSys (b r s k d : Nat) : SRS :=
  [ ([true, false], zeros b ++ [true])
  , (zeros (k + d), zeros k)
  , (ones r, ones s) ]

/-- System 1: Irredundant 3-Rule Length-Preserving Binary Mod-3 Local Normalizer
(2-Layer: 2×2 + 3×3, 9 CPs / 6 non-trivial; strictly minimal: dropping any rule breaks confluence). -/
def mod3SRS : SRS := [
  ([true, false, true], [false, true, false]),
  ([true, true], [false, false]),
  ([true, false, false], [false, false, true])
]

def binValAux (acc : Nat) : Word → Nat
  | [] => acc
  | b :: w => binValAux (2 * acc + if b then 1 else 0) w

def binVal (w : Word) : Nat := binValAux 0 w

/-- MSB-first `m`-bit binary encoding of natural number `x`. -/
def toBits : Nat → Nat → Word
  | 0, _ => []
  | m + 1, x => toBits m (x / 2) ++ [decide (x % 2 = 1)]

/-- The `(2^m - 1)`-rule irredundant length-preserving binary rewriting system computing
exact residue modulo `2^m - 1` for all `m ≥ 2` and all bit-strings of arbitrary width. -/
def mersenneSRS (m : Nat) : SRS :=
  (ones m, zeros m) ::
  (List.range (2 ^ m - 2)).map (fun x => (true :: toBits m x, false :: toBits m (x + 1)))

/-- The `(2^m + 1)`-rule irredundant length-preserving binary rewriting system computing
exact residue modulo `2^m + 1` for all `m ≥ 1` and all bit-strings of arbitrary width. -/
def fermatModSRS (m : Nat) : SRS :=
  ((List.range (2 ^ m - 1)).map (fun x => (true :: toBits m (x + 1), false :: toBits m x))) ++
  [ (true :: zeros m ++ [false], [false, false] ++ ones m)
  , (true :: zeros m ++ [true],  [false, true] ++ zeros m) ]

end CertComp16
