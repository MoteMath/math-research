/-- Helper for negative/mutation testing: corrupt the bVal of a single key in a BinTree. -/
def BinTree.bumpRootBVal : Nat → BinTree StateEntry → Nat → BinTree StateEntry
  | 0, BinTree.l ent, delta => BinTree.l { ent with bVal := ent.bVal + delta }
  | d + 1, BinTree.n left right, delta => BinTree.n (BinTree.bumpRootBVal d left delta) right
  | _, t, _ => t

end CarryDefectEngine
