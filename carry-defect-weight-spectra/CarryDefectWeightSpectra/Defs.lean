/-!
# Definitions (`carry-defect-weight-spectra`)

Carry-defect weight spectra of constant multiplication by a Mersenne-type multiplier: definitions and sorry-free helper lemmas (pure Lean 4 `Init`, zero Mathlib).
-/

namespace CarryDefectEngine


/-! ## Section 1: Pure-Silicon Binary Operations & Bitwise Lemmas -/

def clmulFuel : Nat → Nat → Nat → Nat
  | 0, _, _ => 0
  | k + 1, c, x =>
      if x = 0 then 0
      else (if x % 2 = 1 then c else 0) ^^^ (2 * clmulFuel k c (x / 2))

def clmul (c x : Nat) : Nat := clmulFuel x c x

def popcountFuel : Nat → Nat → Nat
  | 0, _ => 0
  | k + 1, n =>
      if n = 0 then 0
      else n % 2 + popcountFuel k (n / 2)

def popcount (n : Nat) : Nat := popcountFuel n n

def defect (c x : Nat) : Nat := (c * x) ^^^ (clmul c x)

def defectWeight (c x : Nat) : Nat := popcount (defect c x)

def genDefect (c u v x : Nat) : Nat := (u + c * x) ^^^ (v ^^^ clmul c x)

def stepU (c u b : Nat) : Nat := (u + b * c) / 2

def stepV (c v b : Nat) : Nat := (v ^^^ (b * c)) / 2

def emit (u v : Nat) : Nat := (u % 2) ^^^ (v % 2)

inductive BinTree (α : Type) where
  | e : BinTree α
  | l : α → BinTree α
  | n : BinTree α → BinTree α → BinTree α

def BinTree.lookup : Nat → BinTree α → Nat → Option α
  | 0, BinTree.l a, _ => some a
  | d + 1, BinTree.n left right, k =>
      if k % 2 = 0 then BinTree.lookup d left (k / 2)
      else BinTree.lookup d right (k / 2)
  | _, _, _ => none

structure StateEntry where
  u : Nat
  v : Nat
  n0 : Nat
  n1 : Nat
  aVal : Nat
  bVal : Nat

def checkBranch (c depth : Nat) (rootTree : BinTree StateEntry)
    (ent : StateEntry) (b nextId : Nat) : Bool :=
  match BinTree.lookup depth rootTree nextId with
  | none => false
  | some nxt =>
      let e := emit ent.u ent.v
      (nxt.u == stepU c ent.u b) &&
      (nxt.v == stepV c ent.v b) &&
      (ent.aVal <= e + nxt.aVal) &&
      (if e == 1 then ent.bVal <= 1 + nxt.aVal else ent.bVal <= nxt.bVal)

def checkEntry (c depth : Nat) (rootTree : BinTree StateEntry) (ent : StateEntry) : Bool :=
  let p := popcount (ent.u ^^^ ent.v)
  (ent.aVal <= p) &&
  (if ent.u != ent.v then ent.bVal <= p else true) &&
  checkBranch c depth rootTree ent 0 ent.n0 &&
  checkBranch c depth rootTree ent 1 ent.n1

def checkTree (c depth : Nat) (rootTree : BinTree StateEntry) : BinTree StateEntry → Bool
  | BinTree.e => true
  | BinTree.l ent => checkEntry c depth rootTree ent
  | BinTree.n left right =>
      checkTree c depth rootTree left && checkTree c depth rootTree right

/-- Zero-defect m-Fibbinary (m-sparse) automaton: every 1-bit is followed by >= m - 1 zero bits. -/
def isMSparse (m rem x : Nat) : Bool :=
  if h : x = 0 then true
  else if x % 2 = 1 then
    if rem = 0 then isMSparse m (m - 1) (x / 2)
    else false
  else
    isMSparse m (rem - 1) (x / 2)

