import Lib.General.LinearAlgebra.Base
lemma tensor_eq_zero_of_separating {U V} [AddCommGroup U] [AddCommGroup V] {R ι} [CommRing R] [IsDomain R] [IsPrincipalIdealRing R] [Module R U] [Module R V] [Module.IsTorsionFree R V] {f : ι → Module.Dual R U} (hf : ∀ {a}, (∀ i, f i a = 0) → a = 0) Z (h : ∀ i, TensorProduct.lift (.lsmul R V ∘ₗ f i) Z = 0) : Z = 0 := by obtain ⟨S, _, W, rfl⟩ := (by simpa using TensorProduct.exists_finite_submodule_right_of_setFinite {Z}); obtain ⟨b, rfl⟩ := W.eq_repr_basis_right (Module.finBasis ..); simp [b.ext (g := 0) (hf fun i ↦ (Module.finBasis ..).linearIndependent.eq_coords_of_eq (g := 0) (Subtype.ext (by simpa [b.sum_fintype] using h i)) ·)]
lemma norm_mulVec_le {K l m} [NormedField K] [IsUltrametricDist K] [Fintype l] [Fintype m] {M : Matrix l m K} {c} (h : ∀ i j, ‖M i j‖ ≤ c) x (o : 0 ≤ c := by simp) : ‖M.mulVec x‖ ≤ c * ‖x‖ := by simp [*, pi_norm_le_iff_of_nonneg, mul_le_mul, mul_nonneg, norm_le_pi_norm, IsUltrametricDist.norm_sum_le_of_forall_le_of_nonneg, M.mulVec_apply_eq_sum]
lemma eq_zero_of_submersion {E F} [NormedAddCommGroup E] [NormedSpace ℂ E] [CompleteSpace E] [NormedAddCommGroup F] [NormedSpace ℂ F] [CompleteSpace F] {G f} {f' : E →L[ℂ] F} {a} (hG : AnalyticOnNhd ℂ G .univ) (hf : HasStrictFDerivAt f f' a) (h : f'.range = ⊤) (h0 : ∀ᶠ x in nhds a, G (f x) = (0 : ℂ)) y : G y = 0 := congr($(hG.eq_of_eventuallyEq analyticOnNhd_const ((hf.map_nhds_eq_of_surj h).ge h0)) y)
