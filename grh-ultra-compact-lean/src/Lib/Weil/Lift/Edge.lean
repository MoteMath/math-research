lemma integral_piTensor_eq_integratedRep {A} (hu : ∀ w, IsUnitaryRep A (π w) realInner) (k : _ → _ → ℂ) (a : ∀ w, Continuous (k w)) (hk : ∀ w, Integrable fun g ↦ k w g * ‖g.1.1‖ ^ A) (v : _ → fockSpace η) {X} [NormedAddCommGroup X] [NormedSpace ℂ X] [CompleteSpace X] (T : _ →L[ℂ] X) : let F (x : GInf E s) := T (piTensor fun w ↦ k w (x w) • π w (x w) (v w)); Integrable F ∧ ∫ x, F x = T (piTensor fun w ↦ integratedRep (π w) (k w) (v w)) := have := (hu · |>.1); (fun I ↦ ⟨T.integrable_comp I, T.integral_comp_comm I ▸ congrArg T (ext fun z ↦ ((modelEval z).integral_comp_comm I).symm.trans (congr(∏ w, $(map_integratedRep (hu w) (hk w) (modelEval _) _)) ▸ integral_fintype_prod_eq_prod _ :))⟩) (.mono' (.const_mul (.fintype_prod fun w ↦ (integrable_smul_rep (hu w) (hk w) _).norm) _) (Continuous.aestronglyMeasurable (by fun_prop)) (.of_forall fun _ ↦ piTensor.le_opNorm _))
lemma isHalfEdge_of_oscillatorPair {T : _ → _} (hp : ∀ w, OscillatorPair (T w) (π w) (π' w)) (hΦ : ∀ w, IsJointHarmonic (T w) (l w) (l' w) (Φ w)) (hΩ : ∀ v, (∀ x, Ω (x, 1) (piTensor v) = piTensor fun w ↦ π w (x w) (v w)) ∧ ∀ y, Ω (1, y) (piTensor v) = piTensor fun w ↦ π' w (y w) (v w)) : IsHalfEdge Ω (typeKernel (-l) s) (typeKernel l' t) (piTensor (polyVector η <| Φ ·)) := by
 have A := integral_piTensor_eq_integratedRep (hp · |>.unitary_rep) _ (by fun_prop) (hΦ · |>.hasLargeGap.integrable_norm_pow_smul_dsKernel); simp [← hΩ] at A; choose α e using fun a w ↦ (hp w).exists_bump_integratedRep_eq (hΦ w) (monomial (.curry a w) 1); refine (fun h ↦ ⟨h, by simpa [h.apply_one_ne_zero, conj_dsKernel_neg (hΦ _).gap, ↓mul_div, mul_comm, integral_div] using (A _ (realInner _)).2.trans_ne (by simp [realInner_piTensor, Finset.prod_eq_zero_iff, ne_zero_of_re_pos ((hp _).re_inner_integratedRep_pos (hΦ _))]), fun _ ⟨P, o⟩ ↦ o ▸ ⟨∑ a ∈ P.support, P.coeff a • bumpProduct (α a), ?_⟩⟩) (isCuspKernel_typeKernel (l := -l) (hΦ · |>.hasLargeGap.neg)); introv W hy; obtain ⟨⟨L, hL⟩, ⟨_, _, hC⟩, B, ⟨⟩⟩ := Θ.exists_clm_lift (hy.mem_rapidFunctions h), Θ.exists_norm_theta_mul_le (hy.mem_rapidFunctions h), (hΦ · |>.swap.hasLargeGap le_rfl), hy.1; have M v g : _ = S.lift Θ (V.integrated (piTensor v) f) y g := (hL (V.integrated _ f) g).trans (by
  erw [← (A v (_ ∘L V.integrated.flip f)).2, ← hy.3 h.1.2]; simp [← W, ← hL, ↓Θ.lift_omega_left hy.1, Space.lift, ← integral_const_mul]; rw [← integral_inv_eq_self, integral_integral_swap]; simp [-integral_const_mul, typeKernel, ((hΦ _).hasLargeGap le_rfl).isIdempotentKernel_dsKernel.3, ← conj_dsKernel_neg (hΦ _).gap]; ac_rfl; exact (((A v (V.integrated.flip f)).1.norm.comp_inv.const_mul _).comp_fst _).mono' (by fun_prop) (.of_forall fun ⟨x, a⟩ ↦ (hC _ (a * (x, 1)) g).trans' (by simp [← W])))
 have R {k} b (a := by fun_prop) g := integral_piTensor_eq_integratedRep (hp · |>.column_rep.unitary_rep) k a b (fun w ↦ integratedRep (π w) (dsKernel (l w)) (Φ w)) (L g ∘L V.integrated.flip f); obtain ⟨R₀, Q⟩ := R (B · |>.integrable_norm_pow_smul_dsKernel), fun a ↦ R (integrable_bump_inv_smul _ <| α a ·); simp [(hp _).integratedRep_fix (hΦ _) (B _).integrable_norm_pow_smul_dsKernel (B _).isIdempotentKernel_dsKernel.convolution_self, M, ← e, ← hΩ, ← W, ← hL, ← lift_mul_right, -Prod.forall] at R₀ Q; use (funext (R₀ · |>.2) ▸ T.isForm_realConv (isCuspKernel_typeKernel B) ⟨.congr (by fun_prop) (one_mul · ▸ ((lift_mul_right Θ 1 _).trans (hL ..)).symm), Θ.fixesLeft_lift, ·, ·⟩ (R₀ · |>.1)); ext; simp [bumpProduct, Finset.sum_mul, Q, integral_finsetSum, Integrable.const_mul]; nth_rw 1 [P.as_sum]; simp [hL, piTensor_polyVector, monomial_eq, C_mul', prod_prod_type]
lemma isEdge_of_isJointHarmonic (hΦ : ∀ w, IsJointHarmonic (.std t s (γ w) (-γ' w)) (l' w) (-l w) (Φ w)) : IsEdge (realPairWeil γ γ') (typeKernel l s) (typeKernel l' t) ↑(∏ w, rename (w, ·) (Φ w)) := piTensor_polyVector Φ ▸ ⟨neg_neg l ▸ isHalfEdge_of_oscillatorPair (fun _ ↦ .swap oscillatorPair_detTwist) (hΦ · |>.swap) (by simp), by simpa +unfoldPartialApp [typeKernel, ← conj_dsKernel_neg (hΦ _).gap', ← (conj_dsKernel_neg (hΦ _).gap), Pi.star_def] using isHalfEdge_of_oscillatorPair (fun x ↦ oscillatorPair_detTwist) hΦ (by simp)⟩
lemma ParamsCorrespond.isEdge_jointHarmonic (h : ParamsCorrespond γ γ' l l' s t) : IsEdge (realPairWeil γ γ') (typeKernel l s) (typeKernel l' t) (jointHarmonic γ γ' l l' s t) := isEdge_of_isJointHarmonic (epsilon_spec <| h · |>.exists_isJointHarmonic)
