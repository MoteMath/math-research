structure IsHalfEdge where
 isCuspKernel_source : IsCuspKernel 0 e
 inner_ne_zero : ∫ x, realInner Φ (Ω (x, 1) Φ) * (conj (e x) / e 1) ≠ 0
 lift_isForm_and_eq_realConv : ∀ v ∈ range (polyVector _), ∃ α : C_c(_, ℂ), ∀ {V : Space E ι η} {S T y f} (Θ : ThetaKernel _ S T), (∀ x y v f, Θ.ω ((x, 1), y, 1) (V.integrated v f) = V.integrated (Ω (x, y) v) f) → S.IsForm e y → let F := S.lift Θ (V.integrated Φ f) y; (∀ K : OpenSubgroup _, HasLevel F K → T.IsForm e' F) ∧ S.lift Θ (V.integrated v f) y = realConv α F
structure IsEdge extends IsHalfEdge Ω e e' Φ where
 swapped : IsHalfEdge (Ω ·.swap) (star e') (star e) Φ
abbrev negIf {α} [Neg α] d (l : α) := cond d (-l) l
def ParamsCorrespond s t := ∀ w, IsMatch (.std t s (γ w) (-γ' w)) (l' w) (-l w)
def jointHarmonic {E n n' : Type} [Field E] [NumberField E] [Fintype n] [Fintype n'] (γ γ' : InfinitePlace E → ℤ) (l : _ → n → ℤ) (l' : _ → n' → ℤ) s t := ∏ w, (epsilon (IsJointHarmonic (.std t s (γ w) (-γ' w)) (l' w) (-l w))).rename (w, ·)
